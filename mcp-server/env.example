# Copy to .env (or set as real environment variables / in your MCP client's
# server config) and fill in as needed. All are optional -- defaults point
# at the public Engineering-Physics repo's main branch with no auth.

EP_REPO_OWNER=The-Studio-of-Sadiq
EP_REPO_NAME=Engineering-Physics
EP_REPO_BRANCH=main

# Optional. A classic GitHub PAT with public_repo (read) scope raises the
# GitHub API rate limit from 60 requests/hour to 5000/hour for the tree
# listing call (list_repo_structure, and any tool that scans the whole
# repo). Raw file fetches (get_file, and every per-file check) go through
# raw.githubusercontent.com and are not affected by this limit either way.
# Leave blank to use the repo unauthenticated.
GITHUB_TOKEN=
