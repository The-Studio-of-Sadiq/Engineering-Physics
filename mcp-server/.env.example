# Environment variables the server reads. Set them in your MCP client's
# server config ("env" block -- see README.md) or in your shell; the server
# does not load a .env file itself. All are optional.

# "local" (default): read the working copy this server sits in, from disk,
# on every call -- edits show up immediately. "github": read the live repo.
EP_SOURCE=local

# Local mode only. Defaults to the parent folder of mcp-server/.
EP_LOCAL_ROOT=

# GitHub mode only.
EP_REPO_OWNER=The-Studio-of-Sadiq
EP_REPO_NAME=Engineering-Physics
EP_REPO_BRANCH=main

# GitHub mode only. A classic GitHub PAT with public_repo (read) scope raises
# the GitHub API rate limit from 60 requests/hour to 5000/hour for the tree
# listing call (list_repo_structure, and any tool that scans the whole
# repo). Raw file fetches go through raw.githubusercontent.com and are not
# affected by this limit either way. Leave blank to use the repo
# unauthenticated.
GITHUB_TOKEN=
